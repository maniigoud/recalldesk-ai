# ---------------------------------------------------------------------------
# RecallDesk AI - environment template
#
#   cp .env.example backend/.env
#
# Fill in the credentials you need and keep the real file out of git.
# ---------------------------------------------------------------------------

# --- Application ----------------------------------------------------------
APP_ENV=development
APP_NAME=RecallDesk AI
DEBUG=true

# --- Database (MySQL 8 only) ----------------------------------------------
#   mysql -u root -p -e "CREATE DATABASE recall_desk;"
DATABASE_URL=mysql+aiomysql://root:password@localhost:3306/recall_desk

# --- Auth -----------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# The application reads JWT_SECRET_KEY (JWT_SECRET is kept as a familiar alias).
JWT_SECRET=change-me
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Groq (LLM) -----------------------------------------------------------
# https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=60
GROQ_MAX_RETRIES=2

# --- Hindsight (persistent customer memory) -------------------------------
# https://ui.hindsight.vectorize.io  -  the key is shown only once
HINDSIGHT_API_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=
HINDSIGHT_BANK_ID=recall-desk-ai
HINDSIGHT_TIMEOUT_SECONDS=60
HINDSIGHT_RECALL_BUDGET=mid
HINDSIGHT_RECALL_MAX_TOKENS=1200
HINDSIGHT_RETAIN_ASYNC=false

# --- Agent ----------------------------------------------------------------
AGENT_MAX_TOOL_ITERATIONS=4

# --- Frontend origins (comma separated) -----------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Seed (development demo account) --------------------------------------
SEED_DEMO_EMAIL=demo@recalldesk.local
SEED_DEMO_PASSWORD=DemoPassword123!
