# Application
APP_ENV=development
APP_NAME=RecallDesk AI
DEBUG=true

# Database (MySQL 8)
DATABASE_URL=mysql+aiomysql://root:password@localhost:3306/recall_desk

# Auth
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Groq (LLM). Leave GROQ_API_KEY empty to run without the real LLM.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=60
GROQ_MAX_RETRIES=2

# Hindsight (persistent customer memory). Leave empty to run without real memory.
HINDSIGHT_API_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=
HINDSIGHT_BANK_ID=recall-desk-ai
HINDSIGHT_TIMEOUT_SECONDS=60
HINDSIGHT_RECALL_BUDGET=mid
HINDSIGHT_RECALL_MAX_TOKENS=1200
HINDSIGHT_RETAIN_ASYNC=false

# Agent
AGENT_MAX_TOOL_ITERATIONS=4

# CORS (comma separated)
CORS_ORIGINS=http://localhost:5173

# Seed demo credentials (development only)
SEED_DEMO_EMAIL=demo@recalldesk.local
SEED_DEMO_PASSWORD=DemoPassword123!
